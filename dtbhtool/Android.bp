// The DTBH ("Table of Device Tree") tooling of LineageOS hardware/samsung,
// vendored from branch lineage-19.1 (see README.md): mkdtbimg.c (dtbhtoolExynos,
// run by build/tasks/dtb.mk), dtbimg.c, libdtbimg/dtbimg.h, bootimg.h,
// mkbootimg.c, unpackbootimg.c, unpackdtbhimg.c, dtbtool.txt, samsung_dtbh.h.
//
// Two differences against upstream:
//
//   * dtbimg.c includes <samsung_dtbh.h>, and the copy in this folder is the
//     #if 0 skeleton with k3g example values. The values of this device are in
//     include/samsung_dtbh.h and the modules below have that directory on their
//     include path (upstream points TARGET_SPECIFIC_HEADER_PATH at it, which
//     Soong of a TWRP 12.1 tree does not forward).
//
//   * mkdtbhbootimg (mkbootimg.c) is not built. It knows --dt / --dt_dir, but
//     not the --os_version / --kernel_offset / ... this tree passes through
//     BOARD_MKBOOTIMG_ARGS; the dt section is appended by tools/mkbootimg-dt
//     instead.

cc_binary_host {
    name: "dtbhtoolExynos",
    shared_libs: [
        "libdtbimg",
    ],
    static_libs: [
        "libfdt",
    ],
    srcs: [
        "mkdtbimg.c",
    ],
    local_include_dirs: [
        "include", // samsung_dtbh.h
        "libdtbimg",
    ],
}

cc_library {
    name: "libdtbimg",
    host_supported: true,
    srcs: [
        "dtbimg.c",
    ],
    static_libs: [
        "libfdt",
    ],
    local_include_dirs: [
        "include", // samsung_dtbh.h
        "libdtbimg",
    ],
}

// Work on an image that already exists, without a tree: unpackdtbhbootimg -i
// recovery.img -o dir prints the boot header and writes the sections (kernel,
// ramdisk, ..., <name>-dt); unpackdtbhimg -i dir/recovery.img-dt -o dtdir
// -p 2048 prints the DTBH table and dumps the dtbs.
cc_binary_host {
    name: "unpackdtbhbootimg",
    srcs: [
        "unpackbootimg.c",
    ],
}

cc_binary_host {
    name: "unpackdtbhimg",
    srcs: [
        "unpackdtbhimg.c",
    ],
}
