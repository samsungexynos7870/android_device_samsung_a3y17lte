    <!-- Default brightness: code 102/255 (~82 nits) -->
    <screenBrightnessDefault>0.397638</screenBrightnessDefault>

    <autoBrightness enabled="true">
        <brighteningLightDebounceMillis>2000</brighteningLightDebounceMillis>
        <darkeningLightDebounceMillis>5000</darkeningLightDebounceMillis>
    </autoBrightness>

    <!-- Smooth HLG-space ramp rates (units/sec) and duration caps to prevent
         multi-nit stepping across the steep 60..183-nit region (codes 91..128) -->
    <screenBrightnessRampFastDecrease>0.35</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.35</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.08</screenBrightnessRampSlowDecrease>
    <screenBrightnessRampSlowIncrease>0.12</screenBrightnessRampSlowIncrease>
    <screenBrightnessRampIncreaseMaxMillis>3000</screenBrightnessRampIncreaseMaxMillis>
    <screenBrightnessRampDecreaseMaxMillis>4000</screenBrightnessRampDecreaseMaxMillis>

    <ambientLightHorizonLong>5000</ambientLightHorizonLong>
    <ambientLightHorizonShort>2000</ambientLightHorizonShort>

    <displayBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>0.008</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint>
                    <threshold>0.0</threshold>
                    <percentage>5.0</percentage>
                </brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </brighteningThresholds>
        <darkeningThresholds>
            <minimum>0.008</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint>
                    <threshold>0.0</threshold>
                    <percentage>8.0</percentage>
                </brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </darkeningThresholds>
    </displayBrightnessChangeThresholds>

    <!-- Minimum lux delta floors suppress TMD3725 1-lux integer quantization
         jitter (e.g. 9 <-> 10 lux) and indoor screen-reflection hunting -->
    <ambientBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>3.0</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint>
                    <threshold>0.0</threshold>
                    <percentage>12.0</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>100.0</threshold>
                    <percentage>15.0</percentage>
                </brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </brighteningThresholds>
        <darkeningThresholds>
            <minimum>2.0</minimum>
            <brightnessThresholdPoints>
                <brightnessThresholdPoint>
                    <threshold>0.0</threshold>
                    <percentage>20.0</percentage>
                </brightnessThresholdPoint>
                <brightnessThresholdPoint>
                    <threshold>100.0</threshold>
                    <percentage>25.0</percentage>
                </brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </darkeningThresholds>
    </ambientBrightnessChangeThresholds>
</displayConfiguration>
