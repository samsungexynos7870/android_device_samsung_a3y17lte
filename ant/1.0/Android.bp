// ANT HCI HAL (com.qualcomm.qti.ant@1.0) built from source for the
// a3y17lte open-source QCA9377 stack: QTI's AntHci implementation on top
// of a minimal DataHandler shim that routes the ANT channel through
// libbt-vendor's ANT userial ops over the wcnss_filter mux daemon's
// ant_sock. The HIDL interface package itself is source-authored under
// interfaces/ant/1.0 (reverse-engineered from the stock a7y17lte blob; see
// README in the deliverable for hash validation).

cc_library_shared {
    name: "com.qualcomm.qti.ant@1.0-impl",
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "AntHci.cpp",
        "shim/data_handler_ant.cpp",
    ],
    local_include_dirs: ["shim"],
    include_dirs: [
        "device/samsung/a3y17lte/libbt-vendor/include",
        "packages/modules/Bluetooth/system/hci/include",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libdl",
        "libhidlbase",
        "liblog",
        "libutils",
        "com.qualcomm.qti.ant@1.0",
    ],
}

cc_binary {
    name: "com.qualcomm.qti.ant@1.0-service",
    vendor: true,
    relative_install_path: "hw",
    srcs: ["service.cpp"],
    init_rc: ["com.qualcomm.qti.ant@1.0-service.rc"],
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "com.qualcomm.qti.ant@1.0",
    ],
}
