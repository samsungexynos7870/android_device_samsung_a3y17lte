# Generic AOSP android.hardware.bluetooth@1.0-service registers
# android.hardware.bluetooth@1.0::IBluetoothHci.
allow hal_bluetooth_default hal_bluetooth_hwservice:hwservice_manager { add find };

# QCA9377 open-source stack (CAF libbt-vendor): the vendor lib coordinates
# the combo chip bring-up with the wcnss_filter daemon.
unix_socket_connect(hal_bluetooth_default, property, wcnss_filter)
