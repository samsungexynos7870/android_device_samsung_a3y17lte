# Qualcomm wcnss_filter daemon: bridges the CAF libbt-vendor and the QCA9377
# combo chip on the high-speed UART (/dev/ttySAC0). Started/stopped by init
# on vendor.wc_transport.start_hci.
type wcnss_filter, domain;
type wcnss_filter_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(wcnss_filter)

# Combo chip UART (labeled bluetooth_device in file_contexts)
allow wcnss_filter bluetooth_device:chr_file { getattr ioctl open read write };

# Abstract local sockets served by this daemon: "bt_sock" (HCI bridge) and
# "wcnssfilter_ctrl" (1-byte control protocol). No dedicated socket type:
# without a transition the sockets just keep the process context
# (u:r:wcnss_filter:s0), and the HAL client connect is covered domain-level
# by unix_socket_connect(hal_bluetooth_default, wcnss_filter, wcnss_filter).
# A self-domain type_transition to a separate file_type socket label is NOT
# usable here: when creating the socket the kernel pairs the source role
# r with the new type, which the policy only authorizes for object_r, so
# the context comes back invalid, and the transition also mislabels the
# daemon's outbound property socket. (Runtime-proven on permissive audit:
# invalid_context=u:r:wcnss_filter_socket:s0 + denied { set }/connectto on
# /dev/socket/property_service attributed to wcnss_filter_socket.)
# The daemon performs no ioctls on its abstract sockets (which would need
# an allowxperm anyway), so plain domain labeling suffices everywhere.

set_prop(wcnss_filter, vendor_bluetooth_prop)
