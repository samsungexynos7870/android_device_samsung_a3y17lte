# Qualcomm wcnss_filter daemon: bridges the CAF libbt-vendor and the QCA9377
# combo chip on the high-speed UART (/dev/ttySAC0). Started/stopped by init
# on vendor.wc_transport.start_hci.
type wcnss_filter, domain;
type wcnss_filter_exec, exec_type, vendor_file_type, file_type;
type wcnss_filter_socket, file_type;

init_daemon_domain(wcnss_filter)

# Combo chip UART (labeled bluetooth_device in file_contexts)
allow wcnss_filter bluetooth_device:chr_file { getattr ioctl open read write };

# Abstract local sockets served by this daemon: "bt_sock" (HCI bridge) and
# "wcnssfilter_ctrl" (1-byte control protocol). The daemon's sockets get the
# wcnss_filter_socket label via a self-domain transition, so the HAL client
# can be allowed to connect specifically.
type_transition wcnss_filter wcnss_filter:unix_stream_socket wcnss_filter_socket;
# create_stream_socket_perms minus ioctl: granting bare ioctl on sockets
# without an xperm allowlist trips the platform-wide neverallowxperm in
# system/sepolicy/public/domain.te ("ioctl { 0 }"). The daemon performs no
# ioctls on its abstract sockets, so just drop it.
allow wcnss_filter wcnss_filter_socket:unix_stream_socket {
    create read write getattr setattr lock append bind connect listen accept
    getopt setopt shutdown recvfrom sendto
};

set_prop(wcnss_filter, vendor_bluetooth_prop)
