    <!-- Minimum screen brightness setting allowed by the power manager. -->
    <integer name="config_screenBrightnessSettingMinimum">1</integer>

    <!-- Default screen brightness setting (code 102 = 82 nits). -->
    <integer name="config_screenBrightnessSettingDefault">102</integer>

    <!-- Maximum screen brightness allowed by the power manager. -->
    <integer name="config_screenBrightnessSettingMaximum">255</integer>

    <!-- Screen brightness used to dim the screen when user activity timeout expires (~6 nits). -->
    <integer name="config_screenBrightnessDim">17</integer>

    <!-- Stability requirements in milliseconds for accepting a new brightness level. -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">2000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">5000</integer>

    <!-- Skip the initial brightness ramp when the display transitions to STATE_ON. -->
    <bool name="config_skipScreenOnBrightnessRamp">true</bool>

    <!-- Minimum allowable screen brightness to use in a very dark room. -->
    <integer name="config_screenBrightnessDark">1</integer>

    <!-- Fallback brightness animation ramp rates in 0..255 brightness units per second. -->
    <integer translatable="false" name="config_brightness_ramp_rate_slow">21</integer>
    <integer translatable="false" name="config_brightness_ramp_rate_fast">90</integer>

    <!-- Light sensor event rate in milliseconds for automatic brightness control. -->
    <integer name="config_autoBrightnessLightSensorRate">250</integer>
    <integer name="config_autoBrightnessInitialLightSensorRate">250</integer>

    <!-- Period of time in which to consider light samples in milliseconds. -->
    <integer name="config_autoBrightnessAmbientLightHorizon">5000</integer>

    <!-- TMD3725 via SSP requires ~200 ms for its first valid ADC integration cycle. -->
    <integer name="config_lightSensorWarmupTime">250</integer>

    <!-- Screen brightness used while dozing (~6 nits). -->
    <integer name="config_screenBrightnessDoze">17</integer>

    <!-- If true, the doze component is not started until after the screen has been
         turned off and the screen off animation has been performed. -->
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>

    <!-- ComponentName of a dream to show whenever the system would otherwise have
         gone to sleep. -->
    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>

    <!-- Allow automatic adjusting of the screen brightness while dozing in low power state. -->
    <bool name="config_allowAutoBrightnessWhileDozing">true</bool>

    <!-- Reduce brightness while dozing to preserve battery. -->
    <fraction name="config_screenAutoBrightnessDozeScaleFactor">50%</fraction>

    <!-- Whether the always on display mode is available. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>

    <!-- Control whether the always on display mode is enabled by default. -->
    <bool name="config_dozeAlwaysOnEnabled">false</bool>

    <!-- Enable OLED burn-in protection -->
    <bool name="config_enableBurnInProtection">true</bool>

    <!-- Whether a software navigation bar should be shown. -->
    <bool name="config_showNavigationBar">false</bool>

    <!-- Hardware keys present on the device, stored as a bit field. -->
    <integer name="config_deviceHardwareKeys">83</integer>

    <!-- Hardware keys present on the device with the ability to wake, stored as a bit field. -->
    <integer name="config_deviceHardwareWakeKeys">65</integer>

    <!-- Enable support for configuring max aspect ratio per app -->
    <bool name="config_haveHigherAspectRatioScreen">false</bool>

    <!-- WIFI_HIDL_FEATURE_DISABLE_AP_MAC_RANDOMIZATION is deprecated in R so we move to overlay -->
    <bool name="config_wifi_ap_randomization_supported">false</bool>

    <!-- List of biometric sensors on the device, in decreasing strength. -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item> <!-- ID0:Fingerprint:Strong -->
    </string-array>
</resources>
